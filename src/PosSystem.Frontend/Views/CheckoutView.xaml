<UserControl x:Class="PosSystem.Frontend.Views.CheckoutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#0f172a" Foreground="White" FontFamily="Segoe UI">

    <UserControl.Resources>
        <Style x:Key="GoldButton" TargetType="Button">
            <Setter Property="Background" Value="#FBBF24"/>
            <Setter Property="Foreground" Value="#090C15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#cbd5e1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="12,3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="16,0">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NumpadButton" TargetType="Button">
            <Setter Property="Background" Value="#1e293b"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5" Margin="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CategoryPill" TargetType="Button">
            <Setter Property="Background" Value="#1e293b"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="18" Padding="{TemplateBinding Padding}" Margin="0,0,8,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionRowButton" BasedOn="{StaticResource NumpadButton}" TargetType="Button">
            <Setter Property="Background" Value="#0f172a"/>
            <Setter Property="Foreground" Value="#FBBF24"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="225"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="380"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT NAVIGATION SIDEBAR -->
        <Grid Grid.Column="0" Background="#090C15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="18,24,18,16">
                <Border Width="40" Height="40" CornerRadius="20" Background="#FBBF24" Margin="0,0,10,0">
                    <TextBlock Text="POS" Foreground="#090C15" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding CurrentUser.Name}" FontWeight="Bold" Foreground="White" FontSize="13"/>
                    <TextBlock Text="{Binding CurrentUser.Role}" Foreground="#FBBF24" FontSize="11"/>
                    <TextBlock Text="{Binding TerminalName}" Foreground="#64748b" FontSize="11"/>
                </StackPanel>
            </StackPanel>

            <Button Grid.Row="1" Content="+ New Sale (Clear)" Style="{StaticResource GoldButton}" Margin="16,0,16,8" Height="40" Command="{Binding NewSaleCommand}"/>
            <Button Grid.Row="2" Content="{Binding HeldSalesBadge}" Background="#1e293b" Foreground="#38bdf8" FontWeight="SemiBold" Margin="16,0,16,14" Height="36" BorderThickness="0" Command="{Binding HoldOrRecallSaleCommand}"/>

            <StackPanel Grid.Row="3" Margin="0,4,0,0">
                <Button Content="🛒  POS Register" Style="{StaticResource NavButton}" Command="{Binding SwitchSectionCommand}" CommandParameter="Register"/>
                <Button Content="🧾  Transactions &amp; Refunds" Style="{StaticResource NavButton}" Command="{Binding SwitchSectionCommand}" CommandParameter="Transactions"/>
                <Button Content="👥  Customers &amp; Loyalty" Style="{StaticResource NavButton}" Command="{Binding SwitchSectionCommand}" CommandParameter="Customers"/>
                <Button Content="🏦  Shift Till &amp; Z-Report" Style="{StaticResource NavButton}" Command="{Binding SwitchSectionCommand}" CommandParameter="Shift"/>
                <Button Content="⚙️  Back-Office Admin" Style="{StaticResource NavButton}" Command="{Binding SwitchSectionCommand}" CommandParameter="Admin"/>
            </StackPanel>

            <StackPanel Grid.Row="4" Margin="0,0,0,20">
                <Button Content="🔄  Sync Cloud Now" Style="{StaticResource NavButton}" Foreground="#38bdf8" Command="{Binding TriggerCloudSyncCommand}"/>
                <Button Content="🔒  Lock Terminal" Style="{StaticResource NavButton}" Foreground="#fbbf24" Command="{Binding LockStationCommand}"/>
                <Button Content="🚪  Sign Out" Style="{StaticResource NavButton}" Foreground="#f87171" Command="{Binding LogoutCommand}"/>
            </StackPanel>
        </Grid>

        <!-- CENTER WORKSPACE -->
        <Grid Grid.Column="1" Background="#0f172a">
            <Grid.RowDefinitions>
                <RowDefinition Height="72"/>
                <RowDefinition Height="34"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top Header Bar -->
            <Grid Grid.Row="0" Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Prime Supermarket POS" Foreground="#FBBF24" FontSize="19" FontWeight="Bold"/>
                    <TextBlock Text="{Binding AttachedCustomerText}" Foreground="#38bdf8" FontSize="12"/>
                </StackPanel>

                <TextBox Grid.Column="1" Text="{Binding ManualSkuInput, UpdateSourceTrigger=PropertyChanged}" Height="40" Background="#1e293b" Foreground="White" CaretBrush="#FBBF24" BorderBrush="#334155" BorderThickness="1" VerticalContentAlignment="Center" Padding="14,0" Margin="24,0" ToolTip="Scan Barcode or Search by Product Name / SKU (Press Enter to Add)">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding AddManualSkuCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="{Binding SyncStatusText}" Command="{Binding TriggerCloudSyncCommand}" Background="#1e293b" Foreground="#4ade80" BorderBrush="#334155" BorderThickness="1" Padding="12,7" Margin="0,0,10,0" FontSize="11"/>
                    <Button Content="Lock Station" Command="{Binding LockStationCommand}" Background="#1e293b" Foreground="White" BorderBrush="#334155" BorderThickness="1" Padding="12,7" FontSize="12"/>
                </StackPanel>
            </Grid>

            <!-- Live Status Banner -->
            <Border Grid.Row="1" Background="#1e293b" Margin="20,0,20,4" CornerRadius="6" Padding="12,4">
                <TextBlock Text="{Binding StatusMessage}" Foreground="#e2e8f0" FontSize="12" VerticalAlignment="Center"/>
            </Border>

            <!-- 1. REGISTER CATALOG VIEW -->
            <Grid Grid.Row="2" Visibility="{Binding IsRegisterVisible}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Mandatory Shift Float Warning Banner -->
                <Border Grid.Row="0" Visibility="{Binding NoOpenShiftBannerVisibility}" Background="#451a03" BorderBrush="#FBBF24" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="20,6,20,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="⚠️ No Till Shift Open — Declare your physical opening cash float before completing sales." Foreground="#fde68a" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="Open Shift Float →" Style="{StaticResource GoldButton}" Padding="10,4" Margin="10,0,0,0" Command="{Binding SwitchSectionCommand}" CommandParameter="Shift"/>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="20,10,20,10">
                    <ItemsControl ItemsSource="{Binding Categories}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Name}" Style="{StaticResource CategoryPill}"
                                        Command="{Binding DataContext.SelectCategoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <ScrollViewer Grid.Row="2" Margin="15,0,10,10" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding FilteredProducts}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Background="Transparent" BorderThickness="0" Margin="5" Cursor="Hand"
                                        Command="{Binding DataContext.AddProductCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <Border Background="#1e293b" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Width="170" Height="165" Padding="12">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid Grid.Row="0">
                                                <TextBlock Text="{Binding Sku}" Foreground="#94a3b8" FontSize="11"/>
                                                <Border Background="#0f172a" CornerRadius="4" Padding="6,2" HorizontalAlignment="Right">
                                                    <TextBlock Text="{Binding StockBadgeText}" Foreground="#38bdf8" FontSize="10" FontWeight="SemiBold"/>
                                                </Border>
                                            </Grid>
                                            <TextBlock Grid.Row="1" Text="{Binding Name}" Foreground="White" TextWrapping="Wrap" FontSize="14" FontWeight="SemiBold" Margin="0,10,0,0"/>
                                            <Grid Grid.Row="2">
                                                <TextBlock Text="{Binding Barcode, StringFormat=# {0}}" Foreground="#64748b" FontSize="11" VerticalAlignment="Bottom"/>
                                                <TextBlock Text="{Binding Price, StringFormat=C}" Foreground="#FBBF24" FontSize="16" FontWeight="Bold" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- 2. TRANSACTIONS & REFUNDS VIEW -->
            <Grid Grid.Row="2" Visibility="{Binding IsTransactionsVisible}" Margin="20,10,20,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Completed Receipts &amp; Customer Returns" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,0,0,12"/>
                <ListBox Grid.Row="1" ItemsSource="{Binding RecentSales}" Background="#1e293b" BorderBrush="#334155" BorderThickness="1" Foreground="White" HorizontalContentAlignment="Stretch"
                         VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#334155" BorderThickness="0,0,0,1" Padding="12,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170"/>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding ReceiptNumber}" Foreground="#FBBF24" FontWeight="Bold" FontSize="13"/>
                                        <TextBlock Text="{Binding CreatedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Foreground="#94a3b8" FontSize="11"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding PaymentMethod}" Foreground="#38bdf8" FontSize="12" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Status}" Foreground="#cbd5e1" FontSize="11"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding CashierName, StringFormat=Cashier: {0}}" Foreground="White" FontSize="12"/>
                                        <TextBlock Text="{Binding CustomerName, TargetNullValue=Walk-in}" Foreground="#94a3b8" FontSize="11"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="3" Text="{Binding TotalAmount, StringFormat=C}" Foreground="#4ade80" FontWeight="Bold" FontSize="15" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="Receipt" Padding="10,5" Margin="0,0,6,0" Background="#334155" Foreground="White" BorderThickness="0"
                                                Command="{Binding DataContext.ViewSaleReceiptCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                        <Button Content="Refund" Padding="10,5" Background="#7f1d1d" Foreground="#fca5a5" BorderThickness="0"
                                                Command="{Binding DataContext.RefundSaleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <!-- 3. CUSTOMERS & LOYALTY VIEW -->
            <Grid Grid.Row="2" Visibility="{Binding IsCustomersVisible}" Margin="20,10,20,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Customers &amp; Loyalty Directory" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
                <Border Grid.Row="1" Background="#1e293b" CornerRadius="8" Padding="14" Margin="0,0,0,14" BorderBrush="#334155" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="Customer Name" Foreground="#94a3b8" FontSize="11"/>
                            <TextBox Text="{Binding EditableCustomer.Name, UpdateSourceTrigger=PropertyChanged}" Background="#0f172a" Foreground="White" BorderThickness="1" BorderBrush="#334155" Height="34" Padding="8,4"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,10,0">
                            <TextBlock Text="Phone Number" Foreground="#94a3b8" FontSize="11"/>
                            <TextBox Text="{Binding EditableCustomer.Phone, UpdateSourceTrigger=PropertyChanged}" Background="#0f172a" Foreground="White" BorderThickness="1" BorderBrush="#334155" Height="34" Padding="8,4"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="0,0,10,0">
                            <TextBlock Text="Email (Optional)" Foreground="#94a3b8" FontSize="11"/>
                            <TextBox Text="{Binding EditableCustomer.Email, UpdateSourceTrigger=PropertyChanged}" Background="#0f172a" Foreground="White" BorderThickness="1" BorderBrush="#334155" Height="34" Padding="8,4"/>
                        </StackPanel>
                        <Button Grid.Column="3" Content="+ Save Customer" Style="{StaticResource GoldButton}" VerticalAlignment="Bottom" Height="34" Command="{Binding SaveCustomerCommand}"/>
                    </Grid>
                </Border>
                <ListBox Grid.Row="2" ItemsSource="{Binding Customers}" Background="#1e293b" BorderBrush="#334155" BorderThickness="1" Foreground="White" HorizontalContentAlignment="Stretch"
                         VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#334155" BorderThickness="0,0,0,1" Padding="12,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="White" FontSize="14"/>
                                        <TextBlock Text="{Binding Phone}" Foreground="#94a3b8" FontSize="12"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding LoyaltyPoints, StringFormat={}{0} Loyalty Pts}" Foreground="#FBBF24" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding TotalSpent, StringFormat=Spent: {0:C}}" Foreground="#4ade80" VerticalAlignment="Center"/>
                                    <Button Grid.Column="3" Content="Attach to Cart" Style="{StaticResource GoldButton}" Padding="12,6"
                                            Command="{Binding DataContext.AttachCustomerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <!-- 4. SHIFT TILL & Z-REPORT VIEW -->
            <Grid Grid.Row="2" Visibility="{Binding IsShiftVisible}" Margin="20,10,20,20">
                <StackPanel>
                    <TextBlock Text="Shift / Cash Drawer Management &amp; End-of-Day Z-Report" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/>
                    <Border Background="#1e293b" CornerRadius="8" Padding="18" Margin="0,0,0,16" BorderBrush="#334155" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="{Binding ShiftStatusSummary}" Foreground="#FBBF24" FontWeight="Bold" FontSize="14" Margin="0,0,0,14"/>
                            <UniformGrid Columns="4">
                                <StackPanel Margin="4">
                                    <TextBlock Text="Opening Float" Foreground="#94a3b8" FontSize="12"/>
                                    <TextBlock Text="{Binding ActiveShift.OpeningFloat, StringFormat=C}" Foreground="White" FontSize="18" FontWeight="Bold"/>
                                </StackPanel>
                                <StackPanel Margin="4">
                                    <TextBlock Text="Cash Sales (Net)" Foreground="#94a3b8" FontSize="12"/>
                                    <TextBlock Text="{Binding ActiveShift.CashSalesTotal, StringFormat=C}" Foreground="#4ade80" FontSize="18" FontWeight="Bold"/>
                                </StackPanel>
                                <StackPanel Margin="4">
                                    <TextBlock Text="Card + Transfer Sales" Foreground="#94a3b8" FontSize="12"/>
                                    <TextBlock Text="{Binding ActiveShiftNonCashText}" Foreground="#38bdf8" FontSize="18" FontWeight="Bold"/>
                                </StackPanel>
                                <StackPanel Margin="4">
                                    <TextBlock Text="Expected Drawer Cash" Foreground="#94a3b8" FontSize="12"/>
                                    <TextBlock Text="{Binding ExpectedDrawerCashText}" Foreground="#FBBF24" FontSize="20" FontWeight="Bold"/>
                                </StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <UniformGrid Columns="3">
                        <Border Background="#1e293b" CornerRadius="8" Padding="16" Margin="0,0,8,0" BorderBrush="#334155" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="1. Open New Till Shift" FontWeight="Bold" Foreground="White" Margin="0,0,0,8"/>
                                <TextBlock Text="Opening Cash Float:" Foreground="#94a3b8" FontSize="11"/>
                                <TextBox Text="{Binding OpeningFloatInput, UpdateSourceTrigger=PropertyChanged}" Background="#0f172a" Foreground="White" Height="36" Margin="0,6,0,12" Padding="8,6"/>
                                <Button Content="Open Shift" Style="{StaticResource GoldButton}" Command="{Binding OpenShiftCommand}"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#1e293b" CornerRadius="8" Padding="16" Margin="4,0" BorderBrush="#334155" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="2. Safe Drop / Cash Payout" FontWeight="Bold" Foreground="White" Margin="0,0,0,8"/>
                                <TextBlock Text="Amount Removed from Drawer:" Foreground="#94a3b8" FontSize="11"/>
                                <TextBox Text="{Binding CashDropAmountInput, UpdateSourceTrigger=PropertyChanged}" Background="#0f172a" Foreground="White" Height="36" Margin="0,6,0,12" Padding="8,6"/>
                                <Button Content="Record Safe Drop" Background="#334155" Foreground="White" Height="36" BorderThickness="0" Command="{Binding RecordCashDropCommand}"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#1e293b" CornerRadius="8" Padding="16" Margin="8,0,0,0" BorderBrush="#334155" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="3. Blind Close &amp; Print Z-Report" FontWeight="Bold" Foreground="#f87171" Margin="0,0,0,8"/>
                                <TextBlock Text="Physical Counted Cash in Drawer:" Foreground="#94a3b8" FontSize="11"/>
                                <TextBox Text="{Binding ActualCountedCashInput, UpdateSourceTrigger=PropertyChanged}" Background="#0f172a" Foreground="White" Height="36" Margin="0,6,0,12" Padding="8,6"/>
                                <Button Content="Close Shift &amp; Print Z-Report" Background="#ef4444" Foreground="White" FontWeight="Bold" Height="36" BorderThickness="0" Command="{Binding CloseShiftZReportCommand}"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </StackPanel>
            </Grid>

            <!-- 5. BACK-OFFICE ADMIN VIEW -->
            <ScrollViewer Grid.Row="2" Visibility="{Binding IsAdminVisible}" Margin="20,10,20,20" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <TextBlock Text="Back-Office Administration &amp; Inventory Control" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="{Binding InventoryPolicyButtonText}" Background="#1e293b" Foreground="#38bdf8" BorderBrush="#334155" BorderThickness="1" Padding="12,6" Margin="0,0,8,0" Command="{Binding CycleInventoryPolicyCommand}"/>
                            <Button Content="Toggle VAT Inclusive / Exclusive" Background="#334155" Foreground="#FBBF24" Padding="12,6" BorderThickness="0" Command="{Binding ToggleTaxInclusiveCommand}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Dead-Letter Outbox Sync Warning Banner & Queue Inspector -->
                    <Border Visibility="{Binding DeadLetterBannerVisibility}" Background="#450a0a" BorderBrush="#ef4444" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,14">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding DeadLetterBannerText}" Foreground="#fca5a5" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                <Button Grid.Column="1" Content="Retry Failed Syncs" Background="#ef4444" Foreground="White" FontWeight="Bold" Padding="12,6" BorderThickness="0" Margin="12,0,0,0" Command="{Binding RetryFailedSyncsCommand}"/>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding FailedSyncEntries}" Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="160"/>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Sale.ReceiptNumber, TargetNullValue=Sale}" Foreground="#fde68a" FontSize="11" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Column="1" Text="{Binding RetryCount, StringFormat=Retries: {0}}" Foreground="#fca5a5" FontSize="11"/>
                                            <TextBlock Grid.Column="2" Text="{Binding LastError}" Foreground="#fecaca" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                            <Button Grid.Column="3" Content="Dismiss" Padding="8,2" Background="#7f1d1d" Foreground="White" BorderThickness="0" FontSize="10"
                                                    Command="{Binding DataContext.DismissFailedSyncCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- KPI Cards -->
                    <UniformGrid Columns="4" Margin="0,0,0,14">
                        <Border Background="#1e293b" CornerRadius="8" Padding="14" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="Today's Revenue" Foreground="#94a3b8" FontSize="11"/>
                                <TextBlock Text="{Binding TodayRevenueText}" Foreground="#FBBF24" FontSize="20" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#1e293b" CornerRadius="8" Padding="14" Margin="4,0">
                            <StackPanel>
                                <TextBlock Text="Est. Gross Profit" Foreground="#94a3b8" FontSize="11"/>
                                <TextBlock Text="{Binding TodayProfitText}" Foreground="#4ade80" FontSize="20" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#1e293b" CornerRadius="8" Padding="14" Margin="4,0">
                            <StackPanel>
                                <TextBlock Text="Orders Today" Foreground="#94a3b8" FontSize="11"/>
                                <TextBlock Text="{Binding TodaySalesCount}" Foreground="#38bdf8" FontSize="20" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#1e293b" CornerRadius="8" Padding="14" Margin="8,0,0,0">
                            <StackPanel>
                                <TextBlock Text="Low-Stock Alerts" Foreground="#94a3b8" FontSize="11"/>
                                <TextBlock Text="{Binding LowStockCount}" Foreground="#f87171" FontSize="20" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- Add / Update Product Form -->
                    <Border Background="#1e293b" CornerRadius="8" Padding="14" Margin="0,0,0,14" BorderBrush="#334155" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Create or Update Product SKU" FontWeight="Bold" Foreground="#FBBF24" Margin="0,0,0,8"/>
                            <UniformGrid Columns="6">
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Text="Product Name" Foreground="#94a3b8" FontSize="11"/>
                                    <TextBox Text="{Binding EditableProduct.Name, UpdateSourceTrigger=PropertyChanged}" Background="#0f172a" Foreground="White" Height="32" Padding="6,4"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Text="SKU" Foreground="#94a3b8" FontSize="11"/>
                                    <TextBox Text="{Binding EditableProduct.Sku, UpdateSourceTrigger=PropertyChanged}" Background="#0f172a" Foreground="White" Height="32" Padding="6,4"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Text="Barcode" Foreground="#94a3b8" FontSize="11"/>
                                    <TextBox Text="{Binding EditableProduct.Barcode, UpdateSourceTrigger=PropertyChanged}" Background="#0f172a" Foreground="White" Height="32" Padding="6,4"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Text="Cost Price" Foreground="#94a3b8" FontSize="11"/>
                                    <TextBox Text="{Binding EditableProduct.CostPrice, UpdateSourceTrigger=PropertyChanged}" Background="#0f172a" Foreground="White" Height="32" Padding="6,4"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Text="Selling Price" Foreground="#94a3b8" FontSize="11"/>
                                    <TextBox Text="{Binding EditableProduct.Price, UpdateSourceTrigger=PropertyChanged}" Background="#0f172a" Foreground="White" Height="32" Padding="6,4"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Initial Stock" Foreground="#94a3b8" FontSize="11"/>
                                    <TextBox Text="{Binding EditableProduct.Stock, UpdateSourceTrigger=PropertyChanged}" Background="#0f172a" Foreground="White" Height="32" Padding="6,4"/>
                                </StackPanel>
                            </UniformGrid>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <CheckBox Content="Taxable (7.5% VAT)" IsChecked="{Binding EditableProduct.IsTaxable}" Foreground="White" VerticalAlignment="Center" Margin="0,0,20,0"/>
                                <Button Content="Save Product to Catalog" Style="{StaticResource GoldButton}" Command="{Binding SaveProductCommand}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Inventory Table with Quick Restock -->
                    <TextBlock Text="Catalog Inventory &amp; Quick Restock" FontWeight="Bold" Margin="0,0,0,6"/>
                    <ListBox ItemsSource="{Binding FilteredProducts}" Height="210" Background="#1e293b" BorderBrush="#334155" BorderThickness="1" Foreground="White" HorizontalContentAlignment="Stretch" Margin="0,0,0,14"
                             VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Sku}" Foreground="#94a3b8"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Price, StringFormat=C}" Foreground="#FBBF24"/>
                                    <TextBlock Grid.Column="3" Text="{Binding StockBadgeText}" Foreground="#38bdf8"/>
                                    <StackPanel Grid.Column="4" Orientation="Horizontal">
                                        <Button Content="Edit" Padding="8,3" Margin="0,0,6,0" Background="#334155" Foreground="White" BorderThickness="0"
                                                Command="{Binding DataContext.EditProductInAdminCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                        <Button Content="+20 Restock" Padding="8,3" Background="#166534" Foreground="#4ade80" BorderThickness="0"
                                                Command="{Binding DataContext.RestockProductCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Staff Provisioning -->
                    <Border Background="#1e293b" CornerRadius="8" Padding="14" BorderBrush="#334155" BorderThickness="1" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="New Staff Username" Foreground="#94a3b8" FontSize="11"/>
                                <TextBox Text="{Binding NewStaffUsername, UpdateSourceTrigger=PropertyChanged}" Background="#0f172a" Foreground="White" Height="32" Padding="6,4"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                <TextBlock Text="Full Name" Foreground="#94a3b8" FontSize="11"/>
                                <TextBox Text="{Binding NewStaffName, UpdateSourceTrigger=PropertyChanged}" Background="#0f172a" Foreground="White" Height="32" Padding="6,4"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="0,0,8,0">
                                <TextBlock Text="4-Digit PIN" Foreground="#94a3b8" FontSize="11"/>
                                <TextBox Text="{Binding NewStaffPin, UpdateSourceTrigger=PropertyChanged}" Background="#0f172a" Foreground="White" Height="32" Padding="6,4"/>
                            </StackPanel>
                            <Button Grid.Column="3" Content="+ Add Cashier" Style="{StaticResource GoldButton}" VerticalAlignment="Bottom" Height="32" Command="{Binding CreateStaffCommand}"/>
                        </Grid>
                    </Border>

                    <!-- Supervisor Override & Security Audit Trail -->
                    <TextBlock Text="Supervisor Override &amp; Security Audit Trail" FontWeight="Bold" Margin="0,0,0,6"/>
                    <ListBox ItemsSource="{Binding RecentAuditLogs}" Height="160" Background="#1e293b" BorderBrush="#334155" BorderThickness="1" Foreground="White" HorizontalContentAlignment="Stretch"
                             VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="125"/>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="170"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding CreatedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Foreground="#94a3b8" FontSize="11"/>
                                    <TextBlock Grid.Column="1" Text="{Binding ActionType}" Foreground="#FBBF24" FontWeight="SemiBold" FontSize="11"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Description}" Foreground="#e2e8f0" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="3" Text="{Binding AuthorizedByName, StringFormat=Auth: {0}}" Foreground="#4ade80" FontSize="11" HorizontalAlignment="Right"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- RIGHT SIDEBAR: LIVE ORDER CART + NUMPAD -->
        <Grid Grid.Column="2" Background="#1e293b">
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="16,12,16,0">
                <TextBlock Text="Current Order" Foreground="White" FontWeight="Bold" FontSize="15"/>
                <TextBlock Text="{Binding CurrentSale.ReceiptNumber}" Foreground="#FBBF24" HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold"/>
            </Grid>

            <ListBox ItemsSource="{Binding CartItems}" SelectedItem="{Binding SelectedCartItem}" Grid.Row="1" Background="Transparent" BorderThickness="0" Margin="10,4"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch"
                     VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border Background="Transparent" Padding="6,8" BorderBrush="#334155" BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid Grid.Row="0">
                                                <TextBlock Text="{Binding ProductName}" Foreground="White" FontSize="14" FontWeight="SemiBold" Margin="0,0,70,0"/>
                                                <TextBlock Text="{Binding LineSubtotal, StringFormat=C}" Foreground="White" FontSize="14" FontWeight="Bold" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Grid Grid.Row="1" Margin="0,6,0,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Background="#334155" CornerRadius="4" Padding="7,2" Margin="0,0,8,0">
                                                        <TextBlock Text="{Binding Quantity, StringFormat={}{0}x}" Foreground="#FBBF24" FontWeight="Bold"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding UnitPrice, StringFormat=@ {0:C}}" Foreground="#94a3b8" VerticalAlignment="Center" FontSize="12"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <Button Content="-" Width="28" Height="24" Background="#334155" Foreground="White" BorderThickness="0" Margin="0,0,4,0"
                                                            Command="{Binding DataContext.DecreaseQtyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                                    <Button Content="+" Width="28" Height="24" Background="#334155" Foreground="White" BorderThickness="0" Margin="0,0,8,0"
                                                            Command="{Binding DataContext.IncreaseQtyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                                    <Button Content="Void" Width="42" Height="24" Background="Transparent" Foreground="#ef4444" BorderBrush="#ef4444" BorderThickness="1"
                                                            Command="{Binding DataContext.VoidItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>

            <!-- Totals Breakdown -->
            <StackPanel Grid.Row="2" Margin="16,6,16,10">
                <Grid Margin="0,2">
                    <TextBlock Text="Subtotal" Foreground="#94a3b8" FontSize="13"/>
                    <TextBlock Text="{Binding SubtotalText}" Foreground="White" HorizontalAlignment="Right" FontSize="13"/>
                </Grid>
                <Grid Margin="0,2">
                    <TextBlock Text="Discount" Foreground="#94a3b8" FontSize="13"/>
                    <TextBlock Text="{Binding DiscountText}" Foreground="#4ade80" HorizontalAlignment="Right" FontSize="13"/>
                </Grid>
                <Grid Margin="0,2">
                    <TextBlock Text="{Binding TaxLabelText}" Foreground="#94a3b8" FontSize="13"/>
                    <TextBlock Text="{Binding TaxText}" Foreground="White" HorizontalAlignment="Right" FontSize="13"/>
                </Grid>
                <Grid Margin="0,8,0,4">
                    <TextBlock Text="TOTAL" FontSize="22" FontWeight="Bold" Foreground="White" VerticalAlignment="Bottom"/>
                    <TextBlock Text="{Binding TotalText}" FontSize="30" FontWeight="Bold" Foreground="#FBBF24" HorizontalAlignment="Right"/>
                </Grid>
                <Border Background="#0f172a" CornerRadius="4" Padding="10,4" Margin="0,4,0,0">
                    <TextBlock Text="{Binding NumpadDisplayText}" Foreground="#38bdf8" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                </Border>
            </StackPanel>

            <!-- Wired Interactive Numpad & Action Row -->
            <Grid Grid.Row="3" Margin="14,0,14,14" Background="#111827" Height="290">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="1.25*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- Action Row -->
                <Button Grid.Row="0" Grid.Column="0" Content="Disc %" Style="{StaticResource ActionRowButton}" Command="{Binding ApplyDiscountPercentCommand}"/>
                <Button Grid.Row="0" Grid.Column="1" Content="Price Ovr" Style="{StaticResource ActionRowButton}" Command="{Binding ApplyPriceOverrideCommand}"/>
                <Button Grid.Row="0" Grid.Column="2" Content="Qty" Style="{StaticResource ActionRowButton}" Command="{Binding ApplyQtyMultiplierCommand}"/>
                <Button Grid.Row="0" Grid.Column="3" Content="Void All" Style="{StaticResource ActionRowButton}" Foreground="#f87171" Command="{Binding VoidAllCommand}"/>

                <Button Grid.Row="1" Grid.Column="0" Content="7" Style="{StaticResource NumpadButton}" Command="{Binding NumpadDigitCommand}" CommandParameter="7"/>
                <Button Grid.Row="1" Grid.Column="1" Content="8" Style="{StaticResource NumpadButton}" Command="{Binding NumpadDigitCommand}" CommandParameter="8"/>
                <Button Grid.Row="1" Grid.Column="2" Content="9" Style="{StaticResource NumpadButton}" Command="{Binding NumpadDigitCommand}" CommandParameter="9"/>

                <Button Grid.Row="2" Grid.Column="0" Content="4" Style="{StaticResource NumpadButton}" Command="{Binding NumpadDigitCommand}" CommandParameter="4"/>
                <Button Grid.Row="2" Grid.Column="1" Content="5" Style="{StaticResource NumpadButton}" Command="{Binding NumpadDigitCommand}" CommandParameter="5"/>
                <Button Grid.Row="2" Grid.Column="2" Content="6" Style="{StaticResource NumpadButton}" Command="{Binding NumpadDigitCommand}" CommandParameter="6"/>

                <Button Grid.Row="3" Grid.Column="0" Content="1" Style="{StaticResource NumpadButton}" Command="{Binding NumpadDigitCommand}" CommandParameter="1"/>
                <Button Grid.Row="3" Grid.Column="1" Content="2" Style="{StaticResource NumpadButton}" Command="{Binding NumpadDigitCommand}" CommandParameter="2"/>
                <Button Grid.Row="3" Grid.Column="2" Content="3" Style="{StaticResource NumpadButton}" Command="{Binding NumpadDigitCommand}" CommandParameter="3"/>

                <Button Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Content="0" Style="{StaticResource NumpadButton}" Command="{Binding NumpadDigitCommand}" CommandParameter="0"/>
                <Button Grid.Row="4" Grid.Column="2" Content="00" Style="{StaticResource NumpadButton}" Command="{Binding NumpadDigitCommand}" CommandParameter="00"/>

                <Button Grid.Row="1" Grid.Column="3" Grid.RowSpan="2" Style="{StaticResource NumpadButton}" Background="#166534" Command="{Binding QuickExactCashCommand}">
                    <StackPanel>
                        <TextBlock Text="💵" HorizontalAlignment="Center" FontSize="18"/>
                        <TextBlock Text="Exact Cash" FontSize="11" Margin="0,4,0,0" Foreground="White"/>
                    </StackPanel>
                </Button>
                <Button Grid.Row="3" Grid.Column="3" Content="C" Style="{StaticResource NumpadButton}" Foreground="#f87171" Command="{Binding NumpadClearCommand}"/>
                <Button Grid.Row="4" Grid.Column="3" Content="⌫" Style="{StaticResource NumpadButton}" Command="{Binding NumpadBackspaceCommand}"/>

                <Button Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="4" Content="PAY / TENDER (F12)  →" Style="{StaticResource GoldButton}" FontSize="20" Margin="2,8,2,0" Command="{Binding PayCommand}"/>
            </Grid>
        </Grid>

        <!-- OVERLAY 1: MULTI-TENDER PAYMENT MODAL -->
        <Grid Grid.ColumnSpan="3" Background="#CC090C15" Visibility="{Binding PaymentModalVisibility}">
            <Border Background="#1e293b" Width="540" CornerRadius="12" Padding="28" VerticalAlignment="Center" HorizontalAlignment="Center" BorderBrush="#FBBF24" BorderThickness="1">
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <TextBlock Text="Complete Payment &amp; Tender" FontSize="20" FontWeight="Bold" Foreground="#FBBF24"/>
                        <TextBlock Text="{Binding TotalText}" FontSize="24" FontWeight="Bold" Foreground="White" HorizontalAlignment="Right"/>
                    </Grid>

                    <UniformGrid Columns="4" Margin="0,0,0,14">
                        <Button Content="💵 Cash" Margin="3" Padding="8,10" Background="#334155" Foreground="White" BorderThickness="0" Command="{Binding SelectPaymentMethodCommand}" CommandParameter="Cash"/>
                        <Button Content="💳 POS Card" Margin="3" Padding="8,10" Background="#334155" Foreground="White" BorderThickness="0" Command="{Binding SelectPaymentMethodCommand}" CommandParameter="Card"/>
                        <Button Content="🏦 Transfer" Margin="3" Padding="8,10" Background="#334155" Foreground="White" BorderThickness="0" Command="{Binding SelectPaymentMethodCommand}" CommandParameter="BankTransfer"/>
                        <Button Content="⚡ Split Pay" Margin="3" Padding="8,10" Background="#334155" Foreground="White" BorderThickness="0" Command="{Binding SelectPaymentMethodCommand}" CommandParameter="Split"/>
                    </UniformGrid>

                    <UniformGrid Columns="5" Margin="0,0,0,14">
                        <Button Content="Exact" Margin="2" Padding="6" Background="#0f172a" Foreground="#FBBF24" BorderThickness="0" Command="{Binding QuickCashDenomCommand}" CommandParameter="0"/>
                        <Button Content="₦2,000" Margin="2" Padding="6" Background="#0f172a" Foreground="White" BorderThickness="0" Command="{Binding QuickCashDenomCommand}" CommandParameter="2000"/>
                        <Button Content="₦5,000" Margin="2" Padding="6" Background="#0f172a" Foreground="White" BorderThickness="0" Command="{Binding QuickCashDenomCommand}" CommandParameter="5000"/>
                        <Button Content="₦10,000" Margin="2" Padding="6" Background="#0f172a" Foreground="White" BorderThickness="0" Command="{Binding QuickCashDenomCommand}" CommandParameter="10000"/>
                        <Button Content="₦20,000" Margin="2" Padding="6" Background="#0f172a" Foreground="White" BorderThickness="0" Command="{Binding QuickCashDenomCommand}" CommandParameter="20000"/>
                    </UniformGrid>

                    <UniformGrid Columns="3" Margin="0,0,0,12">
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="Cash Tendered" Foreground="#94a3b8" FontSize="11"/>
                            <TextBox Text="{Binding CashTenderInput, UpdateSourceTrigger=PropertyChanged}" Background="#0f172a" Foreground="White" Height="36" FontSize="15" Padding="8,6"/>
                        </StackPanel>
                        <StackPanel Margin="4,0">
                            <TextBlock Text="POS Card Amount" Foreground="#94a3b8" FontSize="11"/>
                            <TextBox Text="{Binding CardTenderInput, UpdateSourceTrigger=PropertyChanged}" Background="#0f172a" Foreground="White" Height="36" FontSize="15" Padding="8,6"/>
                        </StackPanel>
                        <StackPanel Margin="8,0,0,0">
                            <TextBlock Text="Bank Transfer Amount" Foreground="#94a3b8" FontSize="11"/>
                            <TextBox Text="{Binding TransferTenderInput, UpdateSourceTrigger=PropertyChanged}" Background="#0f172a" Foreground="White" Height="36" FontSize="15" Padding="8,6"/>
                        </StackPanel>
                    </UniformGrid>

                    <TextBlock Text="POS Terminal / Bank Transfer Reference (Optional)" Foreground="#94a3b8" FontSize="11"/>
                    <TextBox Text="{Binding PaymentReferenceInput, UpdateSourceTrigger=PropertyChanged}" Background="#0f172a" Foreground="White" Height="34" Margin="0,4,0,14" Padding="8,5"/>

                    <Border Background="#0f172a" CornerRadius="8" Padding="14" Margin="0,0,0,18">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Total Tendered" Foreground="#94a3b8" FontSize="11"/>
                                <TextBlock Text="{Binding PreviewTenderTotalText}" Foreground="White" FontSize="18" FontWeight="Bold"/>
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Right">
                                <TextBlock Text="Change Due to Customer" Foreground="#94a3b8" FontSize="11" HorizontalAlignment="Right"/>
                                <TextBlock Text="{Binding PreviewChangeDueText}" Foreground="#4ade80" FontSize="22" FontWeight="Bold" HorizontalAlignment="Right"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Cancel" Background="#334155" Foreground="White" Height="46" Margin="0,0,10,0" BorderThickness="0" Command="{Binding ClosePaymentModalCommand}"/>
                        <Button Grid.Column="1" Content="CONFIRM &amp; PRINT RECEIPT  →" Style="{StaticResource GoldButton}" Height="46" FontSize="15" Command="{Binding ConfirmPaymentCommand}"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- OVERLAY 2: THERMAL RECEIPT / Z-REPORT VIEWER MODAL -->
        <Grid Grid.ColumnSpan="3" Background="#CC090C15" Visibility="{Binding ReceiptModalVisibility}">
            <Border Background="#1e293b" Width="460" CornerRadius="12" Padding="24" VerticalAlignment="Center" HorizontalAlignment="Center" BorderBrush="#334155" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="🖨️ Thermal Receipt Output (ESC/POS)" FontSize="16" FontWeight="Bold" Foreground="#FBBF24" Margin="0,0,0,12"/>
                    <Border Background="#090C15" CornerRadius="6" Padding="14" MaxHeight="420">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBlock Text="{Binding ReceiptPreviewText}" FontFamily="Consolas" FontSize="12" Foreground="#e2e8f0"/>
                        </ScrollViewer>
                    </Border>
                    <Button Content="Done / Close Preview" Style="{StaticResource GoldButton}" Height="42" Margin="0,16,0,0" Command="{Binding CloseReceiptModalCommand}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- OVERLAY 3: MANAGER / ADMIN AUTHORIZATION PIN MODAL -->
        <Grid Grid.ColumnSpan="3" Background="#CC090C15" Visibility="{Binding ManagerModalVisibility}">
            <Border Background="#1e293b" Width="400" CornerRadius="12" Padding="24" VerticalAlignment="Center" HorizontalAlignment="Center" BorderBrush="#ef4444" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="🔐 Supervisor Authorization" FontSize="18" FontWeight="Bold" Foreground="#FBBF24" Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding ManagerOverridePrompt}" Foreground="#cbd5e1" TextWrapping="Wrap" FontSize="13" Margin="0,0,0,16"/>
                    <TextBlock Text="Enter Manager (2222) or Admin (1234) PIN:" Foreground="#94a3b8" FontSize="11" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding ManagerPinInput, UpdateSourceTrigger=PropertyChanged}" Background="#0f172a" Foreground="White" FontSize="18" Height="40" Padding="10,6" Margin="0,0,0,16">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding ConfirmManagerOverrideCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                    <UniformGrid Columns="2">
                        <Button Content="Cancel" Background="#334155" Foreground="White" Height="40" Margin="0,0,6,0" BorderThickness="0" Command="{Binding CancelManagerOverrideCommand}"/>
                        <Button Content="Authorize" Style="{StaticResource GoldButton}" Height="40" Margin="6,0,0,0" Command="{Binding ConfirmManagerOverrideCommand}"/>
                    </UniformGrid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- OVERLAY 4: STATION LOCK OVERLAY -->
        <Grid Grid.ColumnSpan="3" Background="#F2090C15" Visibility="{Binding LockOverlayVisibility}">
            <Border Background="#1e293b" Width="380" CornerRadius="12" Padding="28" VerticalAlignment="Center" HorizontalAlignment="Center" BorderBrush="#FBBF24" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="🔒 TERMINAL LOCKED" FontSize="20" FontWeight="Bold" Foreground="#FBBF24" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                    <TextBlock Text="{Binding CurrentUser.Name, StringFormat=Locked by {0}}" Foreground="#94a3b8" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                    <TextBlock Text="Enter Cashier or Manager PIN to Resume:" Foreground="#cbd5e1" FontSize="12" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding UnlockPinInput, UpdateSourceTrigger=PropertyChanged}" Background="#0f172a" Foreground="White" FontSize="18" Height="42" Padding="10,6" Margin="0,0,0,16">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding UnlockStationCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                    <Button Content="Unlock Terminal" Style="{StaticResource GoldButton}" Height="42" Command="{Binding UnlockStationCommand}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- OVERLAY 5: PARTIAL / FULL ITEM RETURN & REFUND MODAL -->
        <Grid Grid.ColumnSpan="3" Background="#CC090C15" Visibility="{Binding RefundModalVisibility}">
            <Border Background="#1e293b" Width="560" CornerRadius="12" Padding="24" VerticalAlignment="Center" HorizontalAlignment="Center" BorderBrush="#ef4444" BorderThickness="1">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="{Binding RefundTargetTitle}" FontSize="18" FontWeight="Bold" Foreground="#FBBF24" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Select All" Padding="10,4" Margin="0,0,6,0" Background="#334155" Foreground="White" BorderThickness="0" FontSize="11" Command="{Binding SelectAllRefundItemsCommand}"/>
                            <Button Content="Clear" Padding="10,4" Background="#0f172a" Foreground="#94a3b8" BorderThickness="0" FontSize="11" Command="{Binding ClearRefundItemsCommand}"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Adjust individual line-item quantities to process a partial or full return:" Foreground="#94a3b8" FontSize="12" Margin="0,0,0,10"/>

                    <ListBox ItemsSource="{Binding RefundLineSelections}" MaxHeight="260" Background="#0f172a" BorderBrush="#334155" BorderThickness="1" Foreground="White" HorizontalContentAlignment="Stretch" Margin="0,0,0,14">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#334155" BorderThickness="0,0,0,1" Padding="10,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ProductName}" FontWeight="SemiBold" Foreground="White" FontSize="13"/>
                                            <TextBlock Text="{Binding SoldSummaryText}" Foreground="#94a3b8" FontSize="11"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="-" Width="30" Height="28" Background="#334155" Foreground="White" BorderThickness="0"
                                                    Command="{Binding DataContext.DecreaseRefundQtyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                            <Border Background="#1e293b" CornerRadius="4" Padding="12,4" Margin="6,0">
                                                <TextBlock Text="{Binding ReturnQuantity, StringFormat={}{0}x}" Foreground="#FBBF24" FontWeight="Bold" FontSize="14"/>
                                            </Border>
                                            <Button Content="+" Width="30" Height="28" Background="#334155" Foreground="White" BorderThickness="0"
                                                    Command="{Binding DataContext.IncreaseRefundQtyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border Background="#0f172a" CornerRadius="8" Padding="14,10" Margin="0,0,0,16">
                        <Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Calculated Refund Breakdown" Foreground="#94a3b8" FontSize="11"/>
                                <TextBlock Text="{Binding RefundPreviewSummaryText}" Foreground="#cbd5e1" FontSize="12" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Right">
                                <TextBlock Text="Refund Total" Foreground="#94a3b8" FontSize="11" HorizontalAlignment="Right"/>
                                <TextBlock Text="{Binding RefundPreviewTotalText}" Foreground="#f87171" FontSize="22" FontWeight="Bold" HorizontalAlignment="Right"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Cancel" Background="#334155" Foreground="White" Height="42" Margin="0,0,10,0" BorderThickness="0" Command="{Binding CloseRefundModalCommand}"/>
                        <Button Grid.Column="1" Content="AUTHORIZE &amp; ISSUE REFUND  →" Background="#ef4444" Foreground="White" FontWeight="Bold" Height="42" BorderThickness="0" FontSize="14" Command="{Binding ConfirmRefundModalCommand}"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
