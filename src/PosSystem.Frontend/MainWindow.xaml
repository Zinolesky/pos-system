<Window x:Class="PosSystem.Frontend.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:PosSystem.Frontend.Views"
        xmlns:viewModels="clr-namespace:PosSystem.Frontend.ViewModels"
        Title="Prime POS System" WindowState="Maximized" Background="#0f172a" Foreground="White" FontFamily="Segoe UI">
    
    <Window.Resources>
        <DataTemplate DataType="{x:Type viewModels:LoginViewModel}">
            <views:LoginView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:CheckoutViewModel}">
            <views:CheckoutView />
        </DataTemplate>
    </Window.Resources>

    <ContentControl Content="{Binding CurrentViewModel}" />
</Window>
